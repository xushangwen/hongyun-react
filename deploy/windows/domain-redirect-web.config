<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect aliases to primary domain" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Redirect"
            url="https://hyindustries.com/{R:1}"
            appendQueryString="true"
            redirectType="Permanent"
          />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
