{
  "kind": "collectionType",
  "collectionName": "hongyun_product_placements",
  "info": {
    "singularName": "product-placement",
    "pluralName": "product-placements",
    "displayName": "产品展示位",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-group.product-group",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "displayNameOverride": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "coverOverride": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imageFit": {
      "type": "enumeration",
      "enum": [
        "contain",
        "cover"
      ],
      "default": "cover",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "center",
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "center",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cardVariant": {
      "type": "enumeration",
      "enum": [
        "default",
        "wide",
        "compact"
      ],
      "default": "default",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
