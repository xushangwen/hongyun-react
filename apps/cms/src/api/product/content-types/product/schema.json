{
  "kind": "collectionType",
  "collectionName": "hongyun_products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "产品中心",
    "description": "在这里直接编辑产品，并通过所属行业与所属系统快速筛选定位；同一产品可属于多个行业或系统"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "model": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "family": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-family.product-family",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-category.product-category",
      "inversedBy": "products",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "groups": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-group.product-group",
      "inversedBy": "products",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "categoryNames": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "systemNames": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "placements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-placement.product-placement",
      "mappedBy": "product",
      "pluginOptions": {
        "i18n": {
          "localized": false
        },
        "content-manager": {
          "visible": false
        }
      }
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.media-text",
        "content.video",
        "content.media-gallery",
        "content.feature-grid",
        "content.data-table",
        "content.equipment-grid",
        "content.case-list",
        "content.cta",
        "technical.chart-gallery",
        "technical.metric-chart",
        "technical.simulation-gallery",
        "technical.report-section",
        "technical.evidence-grid",
        "special.renderer"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sourceChecksum": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "catalogRelationsInitialized": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        },
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
