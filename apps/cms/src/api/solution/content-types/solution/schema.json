{
  "kind": "collectionType",
  "collectionName": "hongyun_solutions",
  "info": {
    "singularName": "solution",
    "pluralName": "solutions",
    "displayName": "行业方案",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "industry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::industry.industry",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relatedSolutions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::solution.solution",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.media-text",
        "content.video",
        "content.media-gallery",
        "content.feature-grid",
        "content.data-table",
        "content.equipment-grid",
        "content.case-list",
        "content.cta",
        "technical.chart-gallery",
        "technical.metric-chart",
        "technical.simulation-gallery",
        "technical.report-section",
        "technical.evidence-grid",
        "special.renderer"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sourceChecksum": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
