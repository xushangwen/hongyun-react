{
  "kind": "collectionType",
  "collectionName": "hongyun_product_families",
  "info": {
    "singularName": "product-family",
    "pluralName": "product-families",
    "displayName": "产品系列",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sharedMedia": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sharedDatasetKeys": {
      "type": "customField",
      "customField": "global::structured-json",
      "options": {
        "editorMode": "string-list"
      },
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
