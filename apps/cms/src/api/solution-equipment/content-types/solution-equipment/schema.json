{
  "kind": "collectionType",
  "collectionName": "hongyun_solution_equipments",
  "info": {
    "singularName": "solution-equipment",
    "pluralName": "solution-equipments",
    "displayName": "方案核心设备",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "solution": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::solution.solution",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "titleOverride": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summaryOverride": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mediaOverride": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "altOverride": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "paragraphs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "showProductLink": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imageFit": {
      "type": "enumeration",
      "enum": [
        "contain",
        "cover"
      ],
      "default": "contain",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "center",
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "center",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "mediaSize": {
      "type": "enumeration",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cardVariant": {
      "type": "enumeration",
      "enum": [
        "horizontal",
        "vertical",
        "detailed"
      ],
      "default": "vertical",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
