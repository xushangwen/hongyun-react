{
  "kind": "collectionType",
  "collectionName": "hongyun_case_chapters",
  "info": {
    "singularName": "case-chapter",
    "pluralName": "case-chapters",
    "displayName": "案例章节",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "caseStudy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case-study.case-study",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.media-text",
        "content.video",
        "content.media-gallery",
        "content.feature-grid",
        "content.data-table",
        "content.equipment-grid",
        "content.case-list",
        "content.cta",
        "technical.chart-gallery",
        "technical.metric-chart",
        "technical.simulation-gallery",
        "technical.report-section",
        "technical.evidence-grid",
        "special.renderer"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
