{
  "kind": "singleType",
  "collectionName": "hongyun_contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "联系我们页面",
    "description": "前台联系我们、招聘和基地信息"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero"
    },
    "inquiryTabLabel": {
      "type": "string",
      "default": "技术咨询"
    },
    "joinTabLabel": {
      "type": "string",
      "default": "加入我们"
    },
    "infoTabLabel": {
      "type": "string",
      "default": "联系方式"
    },
    "inquiryPanel": {
      "type": "component",
      "repeatable": false,
      "component": "contact.panel"
    },
    "industryOptions": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "contactCards": {
      "type": "component",
      "repeatable": true,
      "component": "contact.info-card"
    },
    "offices": {
      "type": "component",
      "repeatable": true,
      "component": "contact.office"
    },
    "talentTitle": {
      "type": "string",
      "default": "人才理念"
    },
    "talentDescription": {
      "type": "text"
    },
    "talentValues": {
      "type": "component",
      "repeatable": true,
      "component": "contact.talent-value"
    },
    "jobsTitle": {
      "type": "string",
      "default": "开放职位"
    },
    "jobsDescription": {
      "type": "text"
    },
    "jobListings": {
      "type": "component",
      "repeatable": true,
      "component": "contact.job"
    },
    "resumeTitle": {
      "type": "string",
      "default": "简历投递"
    },
    "resumeDescription": {
      "type": "text"
    },
    "recruitmentPanel": {
      "type": "component",
      "repeatable": false,
      "component": "contact.panel"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sourceChecksum": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
