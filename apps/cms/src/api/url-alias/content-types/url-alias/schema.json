{
  "kind": "collectionType",
  "collectionName": "hongyun_url_aliases",
  "info": {
    "singularName": "url-alias",
    "pluralName": "url-aliases",
    "displayName": "URL 别名",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "path": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "targetType": {
      "type": "enumeration",
      "enum": [
        "product",
        "solution",
        "article",
        "page"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "targetKey": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "solution": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::solution.solution",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pageKey": {
      "type": "enumeration",
      "enum": [
        "home",
        "about",
        "products",
        "solutions",
        "news",
        "contact"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "localeCode": {
      "type": "enumeration",
      "enum": [
        "zh",
        "en"
      ],
      "default": "zh",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "canonical": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "redirectCode": {
      "type": "enumeration",
      "enum": [
        "none",
        "permanent-301",
        "temporary-302"
      ],
      "default": "none",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "categoryContext": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "uniqueKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
