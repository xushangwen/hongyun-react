{
  "kind": "collectionType",
  "collectionName": "hongyun_product_groups",
  "info": {
    "singularName": "product-group",
    "pluralName": "product-groups",
    "displayName": "产品系统（第二级）",
    "description": "行业下的系统层级；例如新能源行业下的双行星动力制浆、高效管线式制浆等系统"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "groups",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "relatedSolution": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::solution.solution",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legacyKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "placements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-placement.product-placement",
      "mappedBy": "group",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "groups",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
