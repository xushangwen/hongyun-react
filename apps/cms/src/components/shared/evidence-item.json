{
  "collectionName": "components_shared_evidence_items",
  "info": {
    "displayName": "证据项"
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "single-image",
        "double-image",
        "metric-chart",
        "data-table",
        "text",
        "sem-eds"
      ],
      "required": true
    },
    "description": {
      "type": "text"
    },
    "mediaItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.media-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "datasetKey": {
      "type": "string"
    },
    "span": {
      "type": "integer",
      "min": 1,
      "max": 3,
      "default": 1
    },
    "layoutVariant": {
      "type": "enumeration",
      "enum": [
        "default",
        "stacked",
        "side-by-side",
        "wide"
      ],
      "default": "default"
    }
  }
}
