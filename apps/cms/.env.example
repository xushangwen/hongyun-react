HOST=127.0.0.1
PORT=1337
PUBLIC_URL=http://127.0.0.1:1337
IS_PROXIED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

APP_KEYS=replace-1,replace-2,replace-3,replace-4
API_TOKEN_SALT=replace-with-random
ADMIN_JWT_SECRET=replace-with-random
TRANSFER_TOKEN_SALT=replace-with-random
JWT_SECRET=replace-with-random
ENCRYPTION_KEY=replace-with-random

# 本地默认 SQLite；生产切换为 mysql。
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
PRIVATE_UPLOAD_DIR=../api/.private-uploads
CLAMSCAN_BIN=clamscan
BFF_WEBHOOK_URL=http://127.0.0.1:3001/api/cms/webhook
CMS_WEBHOOK_SECRET=replace-with-the-same-value-as-api
