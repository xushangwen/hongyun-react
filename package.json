{
  "name": "hongyun-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <=26.x.x"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <5.0.8": "5.0.8",
      "dompurify@>=3.0.0 <3.4.12": "3.4.12",
      "postcss@>=8.0.0 <8.5.18": "8.5.18",
      "qs@>=6.0.0 <6.15.2": "6.15.2",
      "sharp@>=0.34.0 <0.35.0": "0.35.3",
      "tar@>=7.0.0 <7.5.21": "7.5.21"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n web,api,cms -c cyan,magenta,yellow \"pnpm dev\" \"pnpm api:dev\" \"pnpm cms:dev\"",
    "build": "vite build",
    "build:all": "pnpm build && pnpm api:build && pnpm cms:build",
    "lint": "eslint .",
    "test": "vitest run src",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm --filter @hongyun/contracts test && pnpm --filter @hongyun/api test",
    "preview": "vite preview",
    "api:dev": "pnpm --filter @hongyun/api dev",
    "api:build": "pnpm --filter @hongyun/api build",
    "api:start": "pnpm --filter @hongyun/api start",
    "cms:dev": "pnpm --filter @hongyun/cms develop",
    "cms:build": "pnpm --filter @hongyun/cms build",
    "cms:start": "pnpm --filter @hongyun/cms start",
    "cms:manifest": "node scripts/migration/build-content-manifest.mjs",
    "cms:seed": "pnpm cms:manifest && pnpm --filter @hongyun/cms seed && pnpm --filter @hongyun/cms icons:backfill",
    "cms:seed:sync": "pnpm cms:seed",
    "cms:seed:force": "pnpm cms:manifest && MIGRATION_ALLOW_OVERWRITE=true pnpm --filter @hongyun/cms seed:sync && pnpm --filter @hongyun/cms icons:backfill",
    "cms:tokens": "pnpm --filter @hongyun/cms tokens",
    "cms:icons:backfill": "pnpm cms:manifest && pnpm --filter @hongyun/cms icons:backfill",
    "cms:verify": "pnpm --filter @hongyun/cms verify",
    "cms:verify:live": "node scripts/verify-live-integration.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "mapbox-gl": "^3.20.0",
    "nucleo-core-fill-24": "1.1.3",
    "nucleo-core-outline-24": "1.1.3",
    "nucleo-core-outline-32": "1.1.3",
    "nucleo-core-outline-48": "1.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@babel/parser": "7.29.0",
    "concurrently": "9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
